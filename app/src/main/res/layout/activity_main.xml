<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">

    <!-- The Google Map Fragment using FragmentContainerView -->
    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/map"
        android:name="com.google.android.gms.maps.SupportMapFragment"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- API KEY WARNING -->
    <TextView
        android:id="@+id/apiKeyWarning"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#FFDADA"
        android:gravity="center"
        android:padding="16dp"
        android:text="⚠️ GOOGLE MAPS API KEY MISSING\nPlease set your key in AndroidManifest.xml"
        android:textColor="#B00020"
        android:textStyle="bold"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Large Confirmation Overlay Button (DIRECT CHILD) -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/confirmationButton"
        android:layout_width="match_parent"
        android:layout_height="300dp"
        android:layout_margin="32dp"
        android:visibility="gone"
        android:text="DOUBLE TAP\nTO START"
        android:textSize="32sp"
        android:textStyle="bold"
        app:cornerRadius="32dp"
        app:backgroundTint="#FF9800"
        android:textColor="#FFFFFF"
        android:elevation="12dp"
        android:alpha="0.7"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Top Overlay -->
    <LinearLayout
        android:id="@+id/topOverlay"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="8dp"
        app:layout_constraintTop_toTopOf="parent">

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="8dp"
            app:cardCornerRadius="28dp"
            app:cardElevation="4dp"
            app:strokeWidth="0dp">

            <com.google.android.material.appbar.MaterialToolbar
                android:id="@+id/toolbar"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                app:title="AccessNav"
                app:titleCentered="true">

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/modeSwitch"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="start"
                    android:layout_marginStart="16dp"
                    android:checked="false"
                    app:thumbIcon="@drawable/ic_navigation"
                    android:contentDescription="Navigation Mode Toggle" />
                
                <ImageButton
                    android:id="@+id/settingsButton"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_gravity="end"
                    android:layout_marginEnd="12dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:src="@drawable/ic_settings"
                    app:tint="?attr/colorOnSurface"
                    android:contentDescription="Settings" />
            </com.google.android.material.appbar.MaterialToolbar>
        </com.google.android.material.card.MaterialCardView>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:orientation="horizontal">

            <com.google.android.material.chip.Chip
                android:id="@+id/watchChip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Watch"
                app:chipIcon="@drawable/ic_watch"
                android:layout_marginEnd="8dp"
                app:chipBackgroundColor="#CCFFFFFF"
                style="@style/Widget.Material3.Chip.Assist" />

            <com.google.android.material.chip.Chip
                android:id="@+id/beaconChip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Beacon"
                app:chipIcon="@drawable/ic_beacon"
                app:chipBackgroundColor="#CCFFFFFF"
                style="@style/Widget.Material3.Chip.Assist" />
        </LinearLayout>
    </LinearLayout>

    <!-- Bottom Controls -->
    <LinearLayout
        android:id="@+id/bottomControls"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp"
        app:layout_constraintBottom_toBottomOf="parent">

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/activityCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            app:cardCornerRadius="24dp"
            app:cardElevation="6dp"
            app:strokeWidth="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:id="@+id/lastActivityText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Ready to navigate"
                    android:textAppearance="@style/TextAppearance.Material3.BodyLarge"
                    android:gravity="center" />
                
                <TextView
                    android:id="@+id/destinationText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:visibility="gone"
                    android:layout_marginTop="8dp"
                    android:text="Target: ---"
                    android:textAppearance="@style/TextAppearance.Material3.HeadlineSmall"
                    android:textColor="#1A73E8"
                    android:textStyle="bold"
                    android:gravity="center" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/startNavButton"
            android:layout_width="match_parent"
            android:layout_height="72dp"
            android:text="Start Navigation"
            android:textSize="18sp"
            android:textStyle="bold"
            app:cornerRadius="36dp"
            app:backgroundTint="#1A73E8"
            android:textColor="#FFFFFF" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>