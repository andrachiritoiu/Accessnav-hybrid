<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    tools:context=".NavigationActivity">

    <!-- Live Camera Feed (Full Screen) -->
    <androidx.camera.view.PreviewView
        android:id="@+id/viewFinder"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Dark Gradient Overlay (Top) -->
    <View
        android:layout_width="match_parent"
        android:layout_height="200dp"
        android:background="@drawable/bg_top_gradient" />

    <!-- Dark Gradient Overlay (Bottom) -->
    <View
        android:layout_width="match_parent"
        android:layout_height="300dp"
        android:layout_gravity="bottom"
        android:background="@drawable/bg_bottom_gradient" />

    <!-- Top Overlay Controls -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="20dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/muteButton"
            style="@style/Widget.Material3.Button.IconButton.Filled.Tonal"
            android:layout_width="56dp"
            android:layout_height="56dp"
            app:icon="@drawable/ic_volume_up"
            app:iconSize="28dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:backgroundTint="#80000000"
            app:iconTint="#FFFFFF"
            android:contentDescription="Mute Voice" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="end"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/modeSwitch"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="false"
                app:thumbIcon="@drawable/ic_navigation"
                android:contentDescription="Navigation Mode Toggle" />

            <TextView
                android:id="@+id/modeLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="INDOOR MODE"
                android:textColor="#FFFFFF"
                android:textSize="10sp"
                android:textStyle="bold"
                android:letterSpacing="0.1" />
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Mini Map Overlay (Middle Right - Styled) -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/miniMapCard"
        android:layout_width="140dp"
        android:layout_height="140dp"
        android:layout_margin="20dp"
        android:layout_marginTop="100dp"
        android:layout_gravity="top|end"
        app:cardCornerRadius="24dp"
        app:cardElevation="12dp"
        app:strokeColor="#40FFFFFF"
        app:strokeWidth="1dp"
        app:cardBackgroundColor="#80000000">

        <androidx.fragment.app.FragmentContainerView
            android:id="@+id/miniMap"
            android:name="com.google.android.gms.maps.SupportMapFragment"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />
    </com.google.android.material.card.MaterialCardView>

    <!-- Navigation Instruction Card (Bottom Sheet style) -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/bottomSheet"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_margin="16dp"
        app:cardCornerRadius="36dp"
        app:cardBackgroundColor="#CC121212"
        app:cardElevation="0dp"
        app:strokeColor="#33FFFFFF"
        app:strokeWidth="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="28dp">

            <View
                android:layout_width="40dp"
                android:layout_height="4dp"
                android:layout_gravity="center"
                android:background="#60FFFFFF"
                android:layout_marginBottom="24dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="16dp">

                <com.google.android.material.chip.Chip
                    android:id="@+id/detectionBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Searching..."
                    app:chipBackgroundColor="#1A73E8"
                    android:textColor="#FFFFFF"
                    app:chipStrokeWidth="0dp"
                    app:chipCornerRadius="12dp"
                    style="@style/Widget.Material3.Chip.Assist" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:text="• LIVE ASSISTANCE"
                    android:textColor="#80FFFFFF"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/geminiInstruction"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Initializing AI vision..."
                android:textAppearance="@style/TextAppearance.Material3.HeadlineMedium"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:lineSpacingExtra="4dp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#20FFFFFF"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="24dp" />

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_alignParentStart="true"
                    android:layout_centerVertical="true">

                    <ImageView
                        android:id="@+id/hapticIcon"
                        android:layout_width="52dp"
                        android:layout_height="52dp"
                        android:src="@drawable/ic_haptic_forward"
                        app:tint="#00E676"
                        android:background="@drawable/shape_circle_outline"
                        android:padding="12dp" />

                    <TextView
                        android:id="@+id/hapticDescription"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:text="Path is clear"
                        android:textColor="#BDBDBD"
                        android:textSize="16sp"
                        android:textStyle="normal" />
                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/stopNavButton"
                    android:layout_width="wrap_content"
                    android:layout_height="64dp"
                    android:layout_alignParentEnd="true"
                    android:text="Stop"
                    android:paddingHorizontal="32dp"
                    app:cornerRadius="32dp"
                    app:backgroundTint="#CF6679"
                    android:textColor="#000000"
                    android:textStyle="bold" />
            </RelativeLayout>

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
